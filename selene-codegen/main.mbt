///|
suberror CodegenError {
  InvalidInput(String)
}

///|
fn generate(source : String, input : String) -> String raise CodegenError {
  let (items, reports) = @parser.parse_string(source, name=input)
  guard reports.is_empty() else {
    raise InvalidInput("cannot parse MoonBit source: \{input}")
  }
  let out = StringBuilder()
  for item in items {
    guard item is TopTypeDef(decl) else { continue }
    let name = decl.tycon
    let mut marked = false
    for attr in decl.attrs {
      let marker = match attr.parsed {
        Some(Ident(id)) if id.qual == Some("selene") => id.name
        Some(Apply(id, _)) if id.qual == Some("selene") => id.name
        _ => {
          guard !attr.raw.has_prefix("#selene.") else {
            raise InvalidInput(
              "\{input}: invalid attribute \{attr.raw} on \{name}",
            )
          }
          continue
        }
      }
      guard !marked else {
        raise InvalidInput("\{input}: multiple Selene declarations on \{name}")
      }
      marked = true
      guard decl.params.is_empty() else {
        raise InvalidInput("\{input}: generic Selene declaration \{name}")
      }
      guard decl.components is Record(..) ||
        decl.components is TupleStruct(_) ||
        decl.components is Variant(_) else {
        raise InvalidInput("\{input}: \{name} must be a struct or enum")
      }
      let visibility = if decl.type_vis is Pub(..) { "pub " } else { "" }
      match (marker, attr.parsed) {
        ("component", Some(Ident(_))) => {
          let key = "selene_component_key_\{name}"
          out.write_string(
            "\n///|\nlet \{key} : @entity.ComponentKey[\{name}] = ComponentKey()\n",
          )
          out.write_string(
            "\n///|\n\{visibility}impl @entity.Component for \{name} with component_key() {\n  \{key}\n}\n",
          )
          if !visibility.is_empty() {
            hide_method(out, name, "@entity.Component", "component_key")
          }
        }
        ("resource", Some(Apply(_, props))) => {
          guard props.to_array() is [Expr(Ident(factory))] &&
            factory.qual is None else {
            raise InvalidInput(
              "\{input}: #selene.resource on \{name} takes one local factory name",
            )
          }
          let key = "selene_resource_key_\{name}"
          out.write_string(
            "\n///|\nlet \{key} : @ecs.ResourceKey[\{name}] = ResourceKey(\{factory.name})\n",
          )
          out.write_string(
            "\n///|\n\{visibility}impl @ecs.Resource for \{name} with resource_key() {\n  \{key}\n}\n",
          )
          if !visibility.is_empty() {
            hide_method(out, name, "@ecs.Resource", "resource_key")
          }
        }
        _ =>
          raise InvalidInput(
            "\{input}: invalid \{attr.raw} on \{name}; expected #selene.component or #selene.resource(factory)",
          )
      }
    }
  }
  let result = StringBuilder()
  result.write_string("// Generated by Selene codegen. DO NOT EDIT.\n")
  let body = @fmt.format(out.to_string()).trim()
  if !body.is_empty() {
    result.write_char('\n')
    for line in body.split("\n") {
      result.write_string(line.trim_end().to_owned())
      result.write_char('\n')
    }
  }
  result.to_string()
}

///|
fn hide_method(
  out : StringBuilder,
  name : String,
  trait_name : String,
  method_name : String,
) -> Unit {
  out.write_string(
    "\n///|\n#deprecated(\"Use the typed Selene API.\", skip_current_package=true)\n#doc(hidden)\n",
  )
  out.write_string("pub extend \{name} with \{trait_name}::{\{method_name}}\n")
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    raise InvalidInput("usage: codegen <input.mbt> <output.g.mbt>")
  }
  let input = args[1]
  let output = args[2]
  guard input.has_suffix(".mbt") &&
    !input.has_suffix(".g.mbt") &&
    output.has_suffix(".g.mbt") else {
    raise InvalidInput("expected an .mbt source and a separate .g.mbt output")
  }
  let generated = generate(@fs.read_file(input).text(), input)
  if @fs.exists(output) && @fs.read_file(output).text() == generated {
    return
  }
  @fs.write_file(output, generated, create_mode=CreateOrTruncate)
}
