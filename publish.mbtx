---
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}
---

///|
suberror ReleaseError {
  Failed(String)
}

///|
let engine_modules : Array[String] = ["selene-core", "selene-webgpu"]

///|
let example_modules : Array[String] = ["examples", "examples-web"]

///|
let codegen_pin_files : Array[String] = [
  ".github/workflows/build.yaml", "examples/moon.mod", "examples-web/moon.mod", "selene-codegen/README.md",
  "selene-core/src/ecs/README.md",
]

///|
async fn run(command : String, args : Array[String]) -> Unit {
  println("$ \{command} \{args.join(" ")}")
  let code = @process.run(command, args)
  guard code == 0 else {
    raise Failed("Command failed (\{code}): \{command} \{args.join(" ")}")
  }
}

///|
async fn read_text(path : String) -> String {
  @fs.read_file(path).text().replace_all(old="\r\n", new="\n")
}

///|
async fn set_version(module_dir : String, version : String) -> Unit {
  let path = "\{module_dir}/moon.mod"
  let text = read_text(path)
    .split("\n")
    .map(line => {
      if re"^version[[:space:]]*=[[:space:]]*\"[^\"]+\"$".execute(line)
        is Some(_) {
        "version = \"\{version}\""
      } else {
        line.to_owned()
      }
    })
    .join("\n")
  @fs.write_file(path, text, create_mode=CreateOrTruncate)
}

///|
async fn sync_engine_dependencies(version : String) -> Unit {
  for module_dir in engine_modules + example_modules {
    let path = "\{module_dir}/moon.mod"
    let text = read_text(path)
      .split("\n")
      .map(line => {
        re"^([[:space:]]*\"Milky2018/selene(?:_webgpu)?)(?:@[^\"]+)?\""
        .replace_by(line, matched => {
          "\{matched.group(1).unwrap()}@\{version}\""[:]
        })
        .to_owned()
      })
      .join("\n")
    @fs.write_file(path, text, create_mode=CreateOrTruncate)
  }
}

///|
async fn sync_codegen_pins(version : String) -> Unit {
  let changes : Array[(String, String)] = []
  let pattern = re"Milky2018/selene_codegen@[0-9][0-9A-Za-z.+\-]*"
  let replacement = "Milky2018/selene_codegen@\{version}"
  for path in codegen_pin_files {
    let text = read_text(path)
    guard pattern.execute(text) is Some(_) else {
      raise Failed("Missing codegen version pin in \{path}")
    }
    changes.push(
      (path, pattern.replace_by(text, _ => replacement[:]).to_owned()),
    )
  }
  for (path, text) in changes {
    @fs.write_file(path, text, create_mode=CreateOrTruncate)
  }
}

///|
async fn wait_for_codegen(version : String) -> Unit {
  let args = [
    "Milky2018/selene_codegen@\{version}",
    "--check",
    "selene-codegen/main.mbt",
  ]
  for attempt in 0..<12 {
    let (code, stdout, stderr) = @process.collect_output("moonx", args)
    if code == 0 {
      return
    }
    let output = stdout.text() + stderr.text()
    guard output.contains("Prebuilt wasm asset does not exist") && attempt < 11 else {
      raise Failed(output)
    }
    println("Waiting for the published codegen Wasm asset...")
    @async.sleep(5000)
  }
}

///|
async fn sync_generated_sources(version : String) -> Unit {
  let (code, stdout, stderr) = @process.collect_output("git", [
    "ls-files", "-z", "--", "*.mbt",
  ])
  guard code == 0 else { raise Failed(stderr.text()) }
  let sources = stdout
    .text()
    .split("\u0000")
    .filter(s => !s.is_empty())
    .map(s => s.to_owned())
    .to_array()
  let generator = "Milky2018/selene_codegen@\{version}"
  for output in sources {
    if output.has_suffix(".g.mbt") &&
      read_text(output).has_prefix("// Generated by Selene codegen.") {
      let input = output[:output.length() - 6].to_owned() + ".mbt"
      run("moonx", [generator, input, output])
    }
  }
  run("moonx", [generator, "--check"] + sources)
}

///|
async fn publish_codegen(version : String) -> Unit {
  run("moon", ["-C", "selene-codegen", "fmt", ".", "--check"])
  set_version("selene-codegen", version)
  run("moon", ["update"])
  run("moon", ["-C", "selene-codegen", "test", ".", "--deny-warn"])
  run("moon", ["-C", "selene-codegen", "publish"])
  wait_for_codegen(version)
  sync_codegen_pins(version)
  sync_generated_sources(version)
}

///|
async fn publish_release(version : String) -> Unit {
  let changelog = read_text("docs/CHANGELOG.md")
  guard changelog
    .split("\n")
    .any(line => {
      line.has_prefix("## [\{version}] - ") &&
      re"^## \[[0-9]+\.[0-9]+\.[0-9]+\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$".execute(
        line,
      )
      is Some(_)
    }) else {
    raise Failed("Missing dated changelog entry for \{version}")
  }
  publish_codegen(version)
  for module_dir in engine_modules {
    set_version(module_dir, version)
  }
  sync_engine_dependencies(version)
  run("moon", ["update"])
  run("moon", ["fmt", "--check"])
  run("moon", ["check", "--target", "all", "--deny-warn"])
  run("moon", ["test", "--deny-warn"])
  run("moon", ["-C", "selene-core", "publish"])
  run("moon", ["-C", "selene-webgpu", "update"])
  run("moon", ["-C", "selene-webgpu", "publish"])
  run("moon", ["update"])
}

///|
async fn main {
  let args = @env.args()
  let valid = re"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-beta[1-9][0-9]*)?$"
  try {
    match args {
      [_, version] if valid.execute(version) is Some(_) &&
        !version.contains("-beta") => publish_release(version)
      [_, version, "--codegen-only"] if valid.execute(version) is Some(_) &&
        version.contains("-beta") => publish_codegen(version)
      _ => {
        println(
          "Usage: moon run --target wasm publish.mbtx -- <x.y.z> | <x.y.z-betaN> --codegen-only",
        )
        @env.exit(2)
      }
    }
  } catch {
    Failed(message) => {
      @stdio.stderr.write("\{message}\n")
      @env.exit(1)
    }
    err => raise err
  }
}
