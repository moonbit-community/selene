///|
test "commands reserve and flush entities in the queue's world" {
  let previous = @ecs.current_world()
  defer (match previous {
    Some(world) => @ecs.set_current_world(world)
    None => @ecs.clear_current_world()
  })
  let first = @ecs.World()
  let second = @ecs.World()
  @ecs.set_current_world(first)
  let active = @entity.Entity()
  let commands = @commands.commands(second)
  let entity = commands.spawn()
  let values = Map([(entity, 10)])
  let components : @entity.ComponentStore[Int32] = ComponentStore(second)
  commands.insert_component(components, active, 99)
  commands.insert_component(components, entity, 30)
  assert_eq(components.get(entity), None)
  commands.insert(values, active, 99)
  commands.insert(values, entity, 20)
  commands.add(_ => @entity.entity_flush_system(0.0))
  second.flush_commands()
  assert_eq(@ecs.require_current_world().id(), first.id())
  assert_true(entity.belongs_to(second))
  assert_false(values.contains(active))
  assert_eq(values.get(entity), Some(20))
  assert_eq(components.get(entity), Some(30))
  assert_eq(components.get(active), None)
  assert_true(active.is_alive())
  @ecs.set_current_world(second)
  assert_true(entity.is_alive())
  @ecs.set_current_world(first)
  commands.remove_component(components, entity)
  commands.despawn(entity)
  second.flush_commands()
  assert_true(active.is_alive())
  @ecs.set_current_world(second)
  assert_false(entity.is_alive())
  assert_eq(components.get(entity), None)
}

///|
test "deferred bundles initialize before later commands in the queue's world" {
  let previous = @ecs.current_world()
  defer (match previous {
    Some(world) => @ecs.set_current_world(world)
    None => @ecs.clear_current_world()
  })
  let active = @ecs.World()
  @ecs.set_current_world(active)
  let world = @ecs.World()
  let commands = @commands.commands(world)
  let a : @entity.ComponentStore[Int32] = ComponentStore(world)
  let b : @entity.ComponentStore[String] = ComponentStore(world)
  let tag : @entity.ComponentStore[Bool] = ComponentStore(world)
  let bundle = a.spawn_bundle().combine(b.spawn_bundle())
  let first = commands.spawn_bundle(bundle, (11, "first"))
  let second = commands.spawn_bundle(bundle, (22, "second"))
  let alive = @entity.alive_in_world(world)
  assert_false(alive(first))
  assert_eq(a.get(first), None)
  tag.set(second, true)
  commands.insert_component(a, first, 12)
  world.flush_commands()
  assert_eq(@ecs.require_current_world().id(), active.id())
  assert_eq(a.get(first), Some(12))
  assert_eq(b.get(first), Some("first"))
  assert_eq(a.get(second), Some(22))
  assert_eq(b.get(second), Some("second"))
  assert_eq(tag.get(second), Some(true))
  assert_false(alive(first))
  @ecs.set_current_world(world)
  @entity.entity_flush_system(0.0)
  assert_true(alive(first))
  assert_true(alive(second))
}
