///|
test "commands reserve and flush entities in the queue's world" {
  let previous = @ecs.current_world()
  defer (match previous {
    Some(world) => @ecs.set_current_world(world)
    None => @ecs.clear_current_world()
  })
  let first = @ecs.World()
  let second = @ecs.World()
  @ecs.set_current_world(first)
  let active = @entity.Entity()
  let commands = @commands.commands(second)
  let entity = commands.spawn()
  let values = Map([(entity, 10)])
  commands.insert(values, active, 99)
  commands.insert(values, entity, 20)
  commands.add(_ => @entity.entity_flush_system(0.0))
  second.flush_commands()
  assert_eq(@ecs.require_current_world().id(), first.id())
  assert_true(entity.belongs_to(second))
  assert_false(values.contains(active))
  assert_eq(values.get(entity), Some(20))
  assert_true(active.is_alive())
  @ecs.set_current_world(second)
  assert_true(entity.is_alive())
  @ecs.set_current_world(first)
  commands.despawn(entity)
  second.flush_commands()
  assert_true(active.is_alive())
  @ecs.set_current_world(second)
  assert_false(entity.is_alive())
}
