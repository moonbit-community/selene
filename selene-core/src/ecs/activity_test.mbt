///|
test "ordinary queries exclude disabled rows across point, iterator and batch access" {
  let world = @ecs.World()
  let commands = @ecs.commands(world)
  let first = commands.spawn((Position(1), Label("first")))
  let disabled = commands.spawn((Position(2), Label("disabled")))
  let last = commands.spawn((Position(3), Label("last")))
  let query : @ecs.Query[(Position, Label)] = world.query()
  let retained = query.including_inactive()
  @ecs.Schedule().run(world)
  commands.disable(disabled)
  assert_true(query.contains(disabled))
  @ecs.Schedule().run(world)
  assert_eq(query.length(), 2)
  assert_false(query.contains(disabled))
  assert_eq(query.get(disabled), None)
  assert_eq(query.values().collect().length(), 2)
  assert_eq(query.keys().collect().length(), 2)
  assert_eq(query.to_array().length(), 2)
  assert_eq(retained.length(), 3)
  assert_eq(retained.get(disabled), Some((Position(2), Label("disabled"))))
  let seen = []
  let lengths = []
  query.batches(batch => {
    let values : @ecs.WriteColumn[Position] = batch.write_column()
    let labels : @ecs.ReadColumn[Label] = batch.read_column()
    lengths.push((values.length(), labels.length(), batch.length()))
    for row in 0..<batch.length() {
      seen.push(batch.entity(row))
      values[row] = Position(values[row].0 + 10)
    }
  })
  assert_eq(lengths, [(2, 2, 2)])
  assert_eq(seen.length(), 2)
  assert_true(seen.contains(first))
  assert_true(seen.contains(last))
  assert_false(seen.contains(disabled))
  assert_eq(retained.get(disabled), Some((Position(2), Label("disabled"))))
  retained.set(disabled, (Position(20), Label("updated")))
  commands.enable(disabled)
  @ecs.Schedule().run(world)
  assert_eq(query.get(disabled), Some((Position(20), Label("updated"))))
  assert_eq(query.get(first), Some((Position(11), Label("first"))))
  assert_eq(query.get(last), Some((Position(13), Label("last"))))
}

///|
test "despawn permanently deletes disabled subtrees and recycles their slots" {
  let world = @ecs.World()
  let commands = @ecs.commands(world)
  let parent = commands.spawn1(Position(1))
  let child = commands.spawn1(Position(2), parent~)
  let entities = @ecs.Entities(world)
  let hierarchy = @ecs.Hierarchy(world)
  let query : @ecs.Query[@ecs.Single[Position]] = world.query1()
  let retained = query.including_inactive()
  @ecs.Schedule().run(world)
  commands.disable(parent)
  @ecs.Schedule().run(world)
  assert_true(query.is_empty())
  assert_eq(retained.length(), 2)
  assert_true(entities.is_valid(parent))
  assert_false(entities.is_alive(parent))
  assert_false(entities.is_alive(child))
  assert_eq(hierarchy.children(parent), [])
  commands.enable(child)
  @ecs.Schedule().run(world)
  assert_true(query.is_empty())
  commands.enable(parent)
  @ecs.Schedule().run(world)
  assert_eq(query.length(), 2)
  assert_eq(hierarchy.children(parent), [child])
  commands.disable(parent)
  commands.despawn(parent)
  @ecs.Schedule().run(world)
  assert_false(entities.is_valid(parent))
  assert_false(entities.is_valid(child))
  assert_true(retained.is_empty())
  let replacement = commands.spawn1(Position(3))
  @ecs.Schedule().run(world)
  assert_true(
    replacement.slot_index() == parent.slot_index() ||
    replacement.slot_index() == child.slot_index(),
  )
  assert_false(retained.contains(child))
  assert_false(retained.contains(parent))
}

///|
test "activity commands apply in FIFO order and preserve pending children" {
  let world = @ecs.World()
  let other = @ecs.World()
  let commands = @ecs.commands(world)
  let parent = commands.spawn1(Position(1))
  let child = commands.spawn1(Position(2), parent~)
  let query : @ecs.Query[@ecs.Single[Position]] = world.query1()
  commands.disable(parent)
  commands.enable(parent)
  commands.disable(child)
  @ecs.Schedule().run(other)
  assert_true(query.is_empty())
  @ecs.Schedule().run(world)
  assert_eq(query.keys().collect(), [parent])
  assert_eq(query.including_inactive().length(), 2)
  commands.disable(parent)
  @ecs.Schedule().run(world)
  let later = commands.spawn1(Position(3), parent~)
  @ecs.Schedule().run(world)
  assert_false(query.contains(later))
  assert_true(query.including_inactive().contains(later))
  commands.enable(parent)
  @ecs.Schedule().run(world)
  assert_eq(query.length(), 3)
}

///|
test "mixed activity and deletion preserve every joined column and cached view" {
  let world = @ecs.World()
  let commands = @ecs.commands(world)
  let a = commands.spawn((Position(10), Label("a")))
  let b = commands.spawn((Position(20), Label("b")))
  let c = commands.spawn((Position(30), Label("c")))
  let query : @ecs.Query[(Position, Label)] = world.query()
  let retained = query.including_inactive()
  @ecs.Schedule().run(world)
  commands.disable(b)
  @ecs.Schedule().run(world)
  let d = commands.spawn((Position(40), Label("d")))
  @ecs.Schedule().run(world)
  commands.disable(a)
  commands.despawn(c)
  commands.despawn(a)
  @ecs.Schedule().run(world)
  assert_eq(query.get(d), Some((Position(40), Label("d"))))
  assert_eq(query.length(), 1)
  assert_eq(query.single(), Some((d, (Position(40), Label("d")))))
  assert_eq(retained.get(b), Some((Position(20), Label("b"))))
  commands.enable(b)
  commands.despawn(d)
  @ecs.Schedule().run(world)
  assert_eq(query.single(), Some((b, (Position(20), Label("b")))))
  assert_eq(retained.length(), 1)
  let replacement = commands.spawn((Position(50), Label("replacement")))
  @ecs.Schedule().run(world)
  assert_eq(replacement.slot_index(), d.slot_index())
  assert_eq(retained.get(d), None)
  assert_eq(query.get(replacement), Some((Position(50), Label("replacement"))))
  assert_eq(
    query.with_filters([]).including_inactive().get(b),
    Some((Position(20), Label("b"))),
  )
  assert_eq(retained.with_filters([]).get(replacement), query.get(replacement))
}
